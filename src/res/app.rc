#include <windows.h>
#include "resource.h"

IDI_APP ICON "moonup.ico"
IDR_SPLASH_PNG RCDATA "splash_logo.png"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "MoonUp"
      VALUE "FileDescription", "MoonUp - real-time upscaling and frame generation"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "MoonUp"
      VALUE "LegalCopyright", "Copyright (C) 2026 MoonUp"
      VALUE "OriginalFilename", "MoonUp.exe"
      VALUE "ProductName", "MoonUp"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
